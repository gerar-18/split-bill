datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  appleSubject    String?        @unique
  email           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  receipts        Receipt[]

  @@map("users")
}

model Receipt {
  id              String         @id @default(uuid()) // UUID v4 generado por el cliente
  ownerId         String?
  owner           User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  date            DateTime
  currency        String         // Código ISO-4217 (ej. "USD", "MXN", "EUR")
  subtotalCents   BigInt         // Centavos (minor units)
  taxCents        BigInt         // Centavos
  tipCents        BigInt         // Centavos
  totalCents      BigInt         // Centavos
  version         Int            @default(1)
  clientCreatedAt DateTime
  clientUpdatedAt DateTime
  syncedAt        DateTime       @default(now())

  items           ReceiptItem[]
  participants    ReceiptParticipant[]
  sharedSession   SharedSession?

  @@index([ownerId])
  @@index([clientUpdatedAt])
  @@map("receipts")
}

model ReceiptItem {
  id              String         @id @default(uuid())
  receiptId       String
  receipt         Receipt        @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name            String
  quantity        Int            @default(1)
  priceCents      BigInt         // Centavos
  claims          ItemClaim[]

  @@index([receiptId])
  @@map("receipt_items")
}

model ReceiptParticipant {
  id                 String              @id @default(uuid())
  receiptId          String
  receipt            Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name               String
  claims             ItemClaim[]
  sharedParticipants SharedParticipant[]

  @@index([receiptId])
  @@map("receipt_participants")
}

enum SharedSessionStatus {
  ACTIVE
  CLOSED
  QUARANTINED
}

model ItemClaim {
  id            String             @id @default(uuid())
  itemId        String
  item          ReceiptItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  participantId String
  participant   ReceiptParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([itemId, participantId])
  @@index([participantId])
  @@map("item_claims")
}

model SharedSession {
  id                      String               @id @default(uuid())
  shareCode               String               @unique
  receiptId               String               @unique
  receipt                 Receipt              @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  hostTokenHash           String
  status                  SharedSessionStatus  @default(ACTIVE)
  version                 Int                  @default(1)
  includeImage            Boolean              @default(false)
  imageHiddenByModeration Boolean              @default(false)
  imageBase64OptIn        String?
  reportCount             Int                  @default(0)
  expiresAt               DateTime             @db.Timestamptz(3)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)

  sharedParticipants      SharedParticipant[]
  reports                 SessionReport[]

  @@index([expiresAt])
  @@map("shared_sessions")
}

model SharedParticipant {
  id             String             @id @default(uuid())
  sessionId      String
  session        SharedSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId  String
  participant    ReceiptParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  displayName    String
  guestTokenHash String             @unique
  isHost         Boolean            @default(false)
  revokedAt      DateTime?          @db.Timestamptz(3)
  joinedAt       DateTime           @default(now()) @db.Timestamptz(3)

  @@index([sessionId])
  @@index([participantId])
  @@map("shared_participants")
}

model SessionReport {
  id           String        @id @default(uuid())
  sessionId    String
  session      SharedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reporterHash String
  reason       String
  note         String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, reporterHash])
  @@map("session_reports")
}
